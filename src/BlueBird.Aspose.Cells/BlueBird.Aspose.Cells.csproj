<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\BlueBird.snk</AssemblyOriginatorKeyFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DebugType>embedded</DebugType>
        <Version>1.0.0</Version>
        <Authors>BlueBird</Authors>
        <Copyright>Copyright © 2026 BlueBird</Copyright>
        <IsPackable>true</IsPackable>
        <PackageIcon>BlueBird.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Initial release.</PackageReleaseNotes>
        <PackageDescription>Lightweight semantic Excel reader and writer built on Aspose.Cells. Map worksheet columns to .NET models, write typed data, and configure headers, styles, merging, filtering, and validation.</PackageDescription>
        <PackageTags>excel;spreadsheet;aspose.cells;excel-reader;excel-writer;excel-import;excel-export</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <EnablePackageValidation>true</EnablePackageValidation>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/BlueBird360/BlueBird</RepositoryUrl>
        <PackageProjectUrl>https://github.com/BlueBird360/BlueBird</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspose.Cells" Version="24.1.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\BlueBird.png" Pack="true" PackagePath="" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
